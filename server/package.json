{
  "name": "extrovis-cms-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:production": "tsx scripts/start-production.ts",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/prisma-with-config.ts db push",
    "db:push:production": "tsx scripts/prisma-with-config.ts --production db push",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:production": "tsx scripts/seed-production.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
